# Serveur
PORT=
NODE_ENV=development
CLIENT_URL=

# MongoDB
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_super_long
JWT_REFRESH_SECRET=change_me_refresh_secret_super_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Reset password
RESET_TOKEN_EXPIRES_MINUTES=30

# Email (SMTP - ex: Resend, SendGrid, Gmail SMTP, Mailtrap en dev)
SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=" "

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Apple OAuth
APPLE_CLIENT_ID=your apple id
